From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sun, 8 Nov 2026 07:59:14 +0100
Subject: [PATCH 58/67] gdb/infrun: don't throw from the scope exit in
 stop_all_threads

A closed connection made QThreadEvents:0 throw from a destructor.

diff --git a/gdb/infrun.c b/gdb/infrun.c
index 203c36cee87..609299c7c56 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -5766,6 +5766,22 @@ re_enable_target_async ()
     }
 }
 
+/* Enable or disable thread events on the process target of INF, or on
+   all process targets if INF is nullptr.  */
+
+static void
+set_thread_events (inferior *inf, bool enable)
+{
+  for (auto *target : all_non_exited_process_targets ())
+    {
+      if (inf != nullptr && inf->process_target () != target)
+	continue;
+
+      switch_to_target_no_thread (target);
+      target_thread_events (enable);
+    }
+}
+
 /* See infrun.h.  */
 
 void
@@ -5785,33 +5801,29 @@ stop_all_threads (const char *reason, inferior *inf)
 
   scoped_restore_current_thread restore_thread;
 
-  /* Enable thread events on relevant targets.  */
-  for (auto *target : all_non_exited_process_targets ())
-    {
-      if (inf != nullptr && inf->process_target () != target)
-	continue;
+  set_thread_events (inf, true);
 
-      switch_to_target_no_thread (target);
-      target_thread_events (true);
-    }
-
-  SCOPE_EXIT
+  /* If an error leaves this function, disable thread events on the way
+     out.  This must not throw.  If it fails too (e.g. the remote
+     connection has closed), the error being thrown already says why.
+     Otherwise, disable them at the end, where an error can be
+     reported.  */
+  auto disable_on_error = make_scope_exit ([&] ()
     {
-      /* Disable thread events on relevant targets.  */
-      for (auto *target : all_non_exited_process_targets ())
+      try
 	{
-	  if (inf != nullptr && inf->process_target () != target)
-	    continue;
-
-	  switch_to_target_no_thread (target);
-	  target_thread_events (false);
+	  set_thread_events (inf, false);
 	}
-
-      /* Use debug_prefixed_printf directly to get a meaningful function
-	 name.  */
-      if (debug_infrun)
-	debug_prefixed_printf ("infrun", "stop_all_threads", "done");
-    };
+      catch (const gdb_exception &ex)
+	{
+	  /* Use debug_prefixed_printf directly to get a meaningful
+	     function name.  */
+	  if (debug_infrun)
+	    debug_prefixed_printf ("infrun", "stop_all_threads",
+				   "disabling thread events failed: %s",
+				   ex.what ());
+	}
+    });
 
   scoped_disable_commit_resumed disable_commit_resumed ("stop all threads");
 
@@ -5904,6 +5916,11 @@ stop_all_threads (const char *reason, inferior *inf)
 	    }
 	}
     }
+
+  disable_on_error.release ();
+  set_thread_events (inf, false);
+
+  infrun_debug_printf ("done");
 }
 
 /* Handle a TARGET_WAITKIND_NO_RESUMED event.  Return true if we
