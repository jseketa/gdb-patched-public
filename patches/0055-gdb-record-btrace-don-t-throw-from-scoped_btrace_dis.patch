From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 07:14:45 +0100
Subject: [PATCH 55/65] gdb/record-btrace: don't throw from
 ~scoped_btrace_disable

A failed Qbtrace:off after a failed enable threw from a destructor and terminated GDB.

diff --git a/gdb/record-btrace.c b/gdb/record-btrace.c
index dae243ee2db..0ea44e3b967 100644
--- a/gdb/record-btrace.c
+++ b/gdb/record-btrace.c
@@ -357,8 +357,20 @@ struct scoped_btrace_disable
 
   ~scoped_btrace_disable ()
   {
+    /* This runs when an error leaves record_btrace_target_open, and must
+       not throw.  If disabling fails too, e.g. because the remote
+       rejects it, the error already on its way out says what went
+       wrong.  */
     for (thread_info *tp : m_threads)
-      btrace_disable (tp);
+      {
+	try
+	  {
+	    btrace_disable (tp);
+	  }
+	catch (const gdb_exception &)
+	  {
+	  }
+      }
   }
 
   void add_thread (thread_info *thread)
