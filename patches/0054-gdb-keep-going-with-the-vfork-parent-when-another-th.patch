From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 21:50:24 +0100
Subject: [PATCH 54/76] gdb: keep going with the vfork parent when another
 thread reports an event

An event of another thread during a vfork-done wait made GDB resume that thread (internal_resume_ptid assertion).

diff --git a/gdb/infrun.c b/gdb/infrun.c
index 0b1e81c7859..4ef67ea818c 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -9313,6 +9313,29 @@ stop_if_connecting (struct execution_control_state *ecs)
 static void
 keep_going_pass_signal (struct execution_control_state *ecs)
 {
+  /* While a vfork parent waits for vfork-done, an all-stop target
+     resumes only it (see internal_resume_ptid).  A remote stub may
+     still report an event for another thread, for example one that
+     ignores the thread given with Hc and runs them all.  That thread
+     must not run now, with the breakpoints out: leave it stopped, its
+     stop signal recorded as for any thread that stops and is not the
+     one resumed, and keep going with the vfork parent, as before the
+     event.  */
+  thread_info *vfork_parent
+    = ecs->event_thread->inf->thread_waiting_for_vfork_done;
+  if (!target_is_non_stop_p ()
+      && vfork_parent != nullptr
+      && vfork_parent != ecs->event_thread)
+    {
+      infrun_debug_printf ("%s is not the vfork parent, keep going with %s",
+			   ecs->event_thread->ptid.to_string ().c_str (),
+			   vfork_parent->ptid.to_string ().c_str ());
+      switch_to_thread (vfork_parent);
+      ecs->event_thread = vfork_parent;
+      ecs->ptid = vfork_parent->ptid;
+      ecs->hit_singlestep_breakpoint = 0;
+    }
+
   gdb_assert (ecs->event_thread->ptid == inferior_ptid);
   gdb_assert (ecs->event_thread->internal_state () == THREAD_INT_STOPPED);
 
diff --git a/gdb/testsuite/gdb.replay/vfork-other-thread.c b/gdb/testsuite/gdb.replay/vfork-other-thread.c
new file mode 100644
index 00000000000..5ae81ff1ec7
--- /dev/null
+++ b/gdb/testsuite/gdb.replay/vfork-other-thread.c
@@ -0,0 +1,45 @@
