+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+# Test a stub that reports the exit of a process GDB does not know
+# ("W00;process:1"), before the real exit of the program.  GDB passed
+# the event on, and the core found no inferior for it: an internal
+# error in set_current_inferior.  GDB must warn, ignore the event, and
+# report the real exit.
+
+load_lib gdbserver-support.exp
+load_lib gdbreplay-support.exp
+
+require allow_gdbserver_tests
+require has_gdbreplay
+
+standard_testfile connect.c
+
+if { [prepare_for_testing "failed to prepare" $testfile $srcfile] } {
+    return
+}
+
+# Connect to gdbserver with an all-stop target and a remote log in
+# LOG_FILENAME.
+proc_with_prefix record_initial_logfile { log_filename } {
+    clean_restart $::testfile
+
+    # Make sure we're disconnected, in case we're testing with an
+    # extended-remote board, therefore already connected.
+    gdb_test "disconnect" ".*"
+
+    gdb_test_no_output "set sysroot" \
+	"setting sysroot before starting gdbserver"
+
+    set res [gdbserver_start "" $::binfile]
+    set protocol [lindex $res 0]
+    set port [lindex $res 1]
+
+    gdb_test_no_output "set remotelogfile $log_filename" \
+	"setup remotelogfile"
+
+    gdb_test_no_output "maint set target-non-stop off"
+
+    if {![gdb_target_cmd $protocol $port] == 0} {
+	unsupported "couldn't start gdbserver"
+	return
+    }
+
+    gdb_test "continue" ".*" "continue to the end"
+}
+
+# Copy the log in IN_FILENAME to OUT_FILENAME, with "W00;process:1"
+# put in before the reply to GDB's first resume packet.  Return true if
+# the packet was found.
+proc make_replay_log { in_filename out_filename } {
+    set fd [open $in_filename]
+    set lines [split [read $fd] "\n"]
+    close $fd
+
+    set i [lsearch -regexp $lines {^w \+?\$(vCont;[cs]|[cs])[:;#]}]
+    if { $i == -1 } {
+	return false
+    }
+
+    # gdbreplay adds the checksum.
+    set lines [linsert $lines [expr {$i + 1}] "r \$W00;process:1"]
+
+    set fd [open $out_filename "w"]
+    foreach l $lines {
+	puts $fd $l
+    }
+    close $fd
+    return true
+}
+
+set remote_log [standard_output_file replay.log]
+set modified_log [standard_output_file replay-modified.log]
+
+record_initial_logfile $remote_log
+
+if { ![make_replay_log $remote_log $modified_log] } {
+    fail "couldn't make the replay log"
+    return
+}
+
+clean_restart $::testfile
+
+gdb_test "disconnect" ".*"
+gdb_test_no_output "set sysroot"
+gdb_test_no_output "maint set target-non-stop off"
+
+set res [gdbreplay_start $modified_log]
+set protocol [lindex $res 0]
+set port [lindex $res 1]
+
+gdb_test "target $protocol $port" "Remote debugging using .*" "connect"
+
+gdb_test "continue" \
+    [multi_line \
+	 "warning: Remote target reported the exit of process 1, which GDB does not know; ignoring it" \
+	 "\\\[Inferior 1 \\(process $decimal\\) exited normally\\\]"] \
+    "continue, with the exit of an unknown process first"
+
+gdb_test "print 1" " = 1" "gdb is alive"
