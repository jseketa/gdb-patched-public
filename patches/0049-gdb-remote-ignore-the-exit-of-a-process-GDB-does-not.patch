From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 15:56:14 +0100
Subject: [PATCH 49/76] gdb/remote: ignore the exit of a process GDB does not
 know

An exit reported for an unknown process hit an assertion.

diff --git a/gdb/remote.c b/gdb/remote.c
index 9f5939e5415..db4bbb81597 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -9080,7 +9080,12 @@ Packet: '%s'\n"),
 
 		p += sizeof ("process:") - 1;
 		unpack_varlen_hex (p, &upid);
-		pid = upid;
+		/* Without multi-process, GDB made up the pid of the
+		   inferior, and the stub's means nothing to it: let the
+		   caller pick the process, as when the field is left
+		   out.  */
+		if (m_features.remote_multi_process_p ())
+		  pid = upid;
 	      }
 	    else
 	      error (_("unknown stop reply packet: %s"), buf);
@@ -9339,6 +9344,18 @@ remote_target::process_stop_reply (stop_reply_up stop_reply,
 	}
     }
 
+  /* The exit of a process GDB has no inferior for: there is nothing
+     to exit, and the core would not find the process.  */
+  if ((status->kind () == TARGET_WAITKIND_EXITED
+       || status->kind () == TARGET_WAITKIND_SIGNALLED)
+      && find_inferior_pid (this, ptid.pid ()) == nullptr)
+    {
+      warning (_("Remote target reported the exit of process %d, "
+		 "which GDB does not know; ignoring it"), ptid.pid ());
+      status->set_ignore ();
+      return minus_one_ptid;
+    }
+
   if (status->kind () != TARGET_WAITKIND_EXITED
       && status->kind () != TARGET_WAITKIND_SIGNALLED
       && status->kind () != TARGET_WAITKIND_NO_RESUMED)
@@ -9544,6 +9561,11 @@ remote_target::wait_as (ptid_t ptid, target_waitstatus *status,
 						      rs->buf.data ()));
 
 	    event_ptid = process_stop_reply (std::move (stop_reply), status);
+
+	    /* A reply GDB ignored did not answer the resume: the real
+	       one is still to come.  */
+	    if (status->kind () == TARGET_WAITKIND_IGNORE)
+	      rs->waiting_for_stop_reply = 1;
 	    break;
 	  }
 	case 'O':		/* Console output.  */
diff --git a/gdb/testsuite/gdb.replay/exit-unknown-process.exp b/gdb/testsuite/gdb.replay/exit-unknown-process.exp
new file mode 100644
index 00000000000..e45e7f4e4b4
--- /dev/null
+++ b/gdb/testsuite/gdb.replay/exit-unknown-process.exp
@@ -0,0 +1,115 @@
