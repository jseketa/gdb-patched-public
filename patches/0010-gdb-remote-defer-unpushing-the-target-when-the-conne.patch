 }
 
+/* The connection of TARGET has failed, or the user gave up on it.  The
+   caller throws TARGET_CLOSE_ERROR.
+
+   Do not unpush TARGET here: that would delete the threads and the
+   rest of the state of its inferiors, which the code up the stack, the
+   code that used the connection, still holds.  Mark the connection
+   lost instead, so that every later use of it throws without doing
+   any I/O, and unpush TARGET at a point where nothing holds its state:
+   see remote_unpush_lost_targets.  */
+
+static void
+remote_connection_failed (remote_target *target)
+{
+  remote_state *rs = target->get_remote_state ();
+
+  if (rs->connection_lost)
+    return;
+
+  /* Nothing more is coming from the connection; don't let the event
+     loop watch it.  */
+  rs->lost_async = (rs->remote_desc != nullptr
+		    && serial_is_async_p (rs->remote_desc));
+  if (rs->lost_async)
+    serial_async (rs->remote_desc, nullptr, nullptr);
+  rs->connection_lost = true;
+
+  /* If something waits for an event from this target, have the event
+     loop call its wait method, which throws.  */
+  if (rs->lost_async)
+    rs->mark_async_event_handler ();
+
+  /* The files open on the target are gone; closing them must not try
+     to talk to it.  */
+  fileio_handles_invalidate_target (target);
+
+  lost_remote_targets.push_back (target_ops_ref::new_reference (target));
+}
+
+/* Throw TARGET_CLOSE_ERROR if the connection of the remote target RS
+   belongs to has been lost.  */
+
+static void
+check_connection_lost (remote_state *rs)
+{
+  if (rs->connection_lost)
+    throw_error (TARGET_CLOSE_ERROR, _("Remote connection closed"));
+}
+
+/* Whether EX is the error of the lost connection of this target.
+
+   Operations that only undo something on the remote side or tell it
+   something (remove a breakpoint, stop, close a file, ...) have nothing
+   to do once the connection is lost, so they catch this error and
+   return as if they had succeeded, also when they are the ones that
+   find the loss.  Their callers, often cleanups, then go on with their
+   own work instead of being cut short.  The next operation that needs
+   the connection (read, write, resume, wait) throws.  */
+
+bool
+remote_target::connection_lost_error (const gdb_exception_error &ex)
+{
+  return (ex.error == TARGET_CLOSE_ERROR
+	  && get_remote_state ()->connection_lost);
+}
+
+/* See remote.h.  */
+
+void
+remote_unpush_lost_targets ()
+{
+  while (!lost_remote_targets.empty ())
+    {
+      target_ops_ref ref = std::move (lost_remote_targets.back ());
+      lost_remote_targets.pop_back ();
+
+      try
+	{
+	  remote_unpush_target (static_cast<remote_target *> (ref.get ()));
+	}
+      catch (const gdb_exception_error &ex)
+	{
+	  exception_print (gdb_stderr, ex);
+	}
+    }
+}
+
 [[noreturn]] static void
 remote_unpush_and_throw (remote_target *target)
 {
-  remote_unpush_target (target);
+  remote_connection_failed (target);
   throw_error (TARGET_CLOSE_ERROR, _("Disconnected from target."));
 }
 
