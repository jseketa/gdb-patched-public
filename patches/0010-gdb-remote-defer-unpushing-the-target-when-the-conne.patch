+  lost_remote_targets.erase
+    (std::remove_if (lost_remote_targets.begin (),
+		     lost_remote_targets.end (),
+		     [target] (const target_ops_ref &ref)
+		     { return ref.get () == target; }),
+     lost_remote_targets.end ());
+
   /* We have to unpush the target from all inferiors, even those that
      aren't running.  */
   scoped_restore_current_inferior restore_current_inferior;
@@ -6574,10 +6633,96 @@ remote_unpush_target (remote_target *target)
