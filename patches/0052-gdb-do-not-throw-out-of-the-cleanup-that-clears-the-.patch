From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Fri, 20 Nov 2026 18:30:47 +0100
Subject: [PATCH 52/65] gdb: do not throw out of the cleanup that clears the
 symtab users

A lost connection while reading symbols after an exec threw out of a scope exit; GDB aborted.

diff --git a/gdb/symfile.c b/gdb/symfile.c
index 3500f22d697..a9408259d57 100644
--- a/gdb/symfile.c
+++ b/gdb/symfile.c
@@ -51,7 +51,7 @@
 #include "gdbsupport/pathstuff.h"
 #include "gdbsupport/selftest.h"
 #include "cli/cli-style.h"
-#include "gdbsupport/forward-scope-exit.h"
+#include "exceptions.h"
 #include "gdbsupport/buildargv.h"
 #include "filesystem.h"
 
@@ -71,8 +71,46 @@ void (*deprecated_show_load_progress) (const char *section,
 void (*deprecated_pre_add_symbol_hook) (const char *);
 void (*deprecated_post_add_symbol_hook) (void);
 
-using clear_symtab_users_cleanup
-  = FORWARD_SCOPE_EXIT (clear_symtab_users);
+/* Calls clear_symtab_users when destroyed, unless released: when
+   reading new symbols failed, so that nothing keeps using the partial
+   symbol tables.  The error that made the reading fail is on its way
+   out then, so an error from clear_symtab_users itself (e.g. from
+   reading target memory to re-set the breakpoints, when the
+   connection to the target was lost) is printed, not thrown.  */
+
+class clear_symtab_users_cleanup
+{
+public:
+  explicit clear_symtab_users_cleanup (symfile_add_flags add_flags)
+    : m_add_flags (add_flags)
+  {}
+
+  ~clear_symtab_users_cleanup ()
+  {
+    if (m_released)
+      return;
+
+    try
+      {
+	clear_symtab_users (m_add_flags);
+      }
+    catch (const gdb_exception_error &ex)
+      {
+	exception_print (gdb_stderr, ex);
+      }
+  }
+
+  void release ()
+  {
+    m_released = true;
+  }
+
+  DISABLE_COPY_AND_ASSIGN (clear_symtab_users_cleanup);
+
+private:
+  symfile_add_flags m_add_flags;
+  bool m_released = false;
+};
 
 /* Global variables owned by this file.  */
 
