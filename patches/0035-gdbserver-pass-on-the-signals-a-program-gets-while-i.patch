From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 20:20:20 +0100
Subject: [PATCH 35/76] gdbserver: pass on the signals a program gets while it
 starts up

Startup hung when the shell waited for a signal gdbserver dropped (zsh command substitution, fish).

diff --git a/gdb/testsuite/gdb.server/startup-shell-signal-shell.c b/gdb/testsuite/gdb.server/startup-shell-signal-shell.c
new file mode 100644
index 00000000000..74c314ffef1
--- /dev/null
+++ b/gdb/testsuite/gdb.server/startup-shell-signal-shell.c
@@ -0,0 +1,64 @@
+/* This testcase is part of GDB, the GNU debugger.
+
+   Copyright 2026 Free Software Foundation, Inc.
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3 of the License, or
+   (at your option) any later version.
+
+   This program is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+
+   You should have received a copy of the GNU General Public License
+   along with this program.  If not, see <http://www.gnu.org/licenses/>.  */
+
+/* A stand-in for $SHELL that gets a signal before it runs the
+   program, as a real shell can (for example SIGCHLD from a command in
+   its startup files).  It is run as SHELL -c "exec PROGRAM ARGS".  */
+
+#include <signal.h>
+#include <string.h>
+#include <unistd.h>
+
+static volatile sig_atomic_t got_signal;
+
+static void
+handler (int sig)
+{
+  got_signal = 1;
+}
+
+int
+main (int argc, char **argv)
+{
+  char *prog, *end;
+
+  signal (SIGUSR1, handler);
+  raise (SIGUSR1);
+
+  /* The signal did not reach us.  */
+  if (!got_signal)
+    return 3;
+
+  if (argc != 3 || strcmp (argv[1], "-c") != 0
+      || strncmp (argv[2], "exec ", 5) != 0)
+    return 4;
+
+  /* The program, maybe quoted, without arguments.  */
+  prog = argv[2] + 5;
+  if (*prog == '\'')
+    {
+      prog++;
+      end = strchr (prog, '\'');
+    }
+  else
+    end = strchr (prog, ' ');
+  if (end != NULL)
+    *end = '\0';
+
+  execl (prog, prog, (char *) NULL);
+  return 5;
+}
