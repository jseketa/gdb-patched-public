From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 14:35:04 +0100
Subject: [PATCH 33/48] gdb/remote: give a process exit to a wait for one of
 its threads

An exit reported for the process never reached a wait for one of its threads: GDB spun forever.

diff --git a/gdb/remote.c b/gdb/remote.c
index 775ac38f031..861db5ae33e 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -8417,7 +8417,10 @@ remote_target::discard_pending_stop_replies_in_queue ()
 }
 
 /* Remove the first reply in 'stop_reply_queue' which matches
-   PTID.  */
+   PTID.  The exit of a process, which the stub reports for the
+   process as a whole, matches a PTID naming one of its threads too:
+   the thread has gone with it, and a wait for that thread must see
+   the exit.  */
 
 stop_reply_up
 remote_target::remote_notif_remove_queued_reply (ptid_t ptid)
@@ -8428,7 +8431,14 @@ remote_target::remote_notif_remove_queued_reply (ptid_t ptid)
 			    rs->stop_reply_queue.end (),
 			    [=] (const stop_reply_up &event)
 			    {
-			      return event->ptid.matches (ptid);
+			      if (event->ptid.matches (ptid))
+				return true;
+
+			      target_waitkind kind = event->ws.kind ();
+			      return ((kind == TARGET_WAITKIND_EXITED
+				       || kind == TARGET_WAITKIND_SIGNALLED)
+				      && event->ptid.is_pid ()
+				      && event->ptid.pid () == ptid.pid ());
 			    });
   stop_reply_up result;
   if (iter != rs->stop_reply_queue.end ())
