From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Thu, 19 Nov 2026 01:48:49 +0100
Subject: [PATCH 46/67] gdb: do not resume a program stopped at an exec while
 connecting

Reconnecting at an exec catchpoint resumed the program and asserted in post_create_inferior.

diff --git a/gdb/infrun.c b/gdb/infrun.c
index 1c43a373ab6..203c36cee87 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -3883,8 +3883,11 @@ start_remote (int from_tty)
 
   /* Now that the inferior has stopped, do any bookkeeping like
      loading shared libraries.  We want to do this before normal_stop,
-     so that the displayed frame is up to date.  */
-  post_create_inferior (from_tty, true);
+     so that the displayed frame is up to date.  If the target reported
+     the program stopped at an exec, follow_exec has already set the
+     program space up for the new program, its solib_ops included.  */
+  post_create_inferior (from_tty,
+			current_program_space->solib_ops ().empty ());
 
   normal_stop ();
 }
@@ -6653,6 +6656,17 @@ handle_inferior_event (struct execution_control_state *ecs)
       ecs->event_thread->set_stop_pc
 	(regcache_read_pc (get_thread_regcache (ecs->event_thread)));
 
+      /* While GDB connects to a remote target, the target may report
+	 the program stopped at an exec, e.g. because an earlier
+	 session stopped it there.  Connecting must leave the program
+	 where it is, so do not resume it: start_remote sets it up
+	 as stopped.  */
+      if (ecs->event_thread->inf->control.stop_soon == STOP_QUIETLY_REMOTE)
+	{
+	  stop_waiting (ecs);
+	  return;
+	}
+
       ecs->event_thread->control.stop_bpstat
 	= bpstat_stop_status_nowatch (ecs->event_thread->inf->aspace.get (),
 				      ecs->event_thread->stop_pc (),
