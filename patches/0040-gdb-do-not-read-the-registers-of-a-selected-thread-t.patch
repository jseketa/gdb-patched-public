From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 16:29:04 +0100
Subject: [PATCH 40/72] gdb: do not read the registers of a selected thread
 that has exited

An exited selected thread hit an assertion in get_thread_regcache.

diff --git a/gdb/frame.c b/gdb/frame.c
index 6b02c5f559a..9985a21ca85 100644
--- a/gdb/frame.c
+++ b/gdb/frame.c
@@ -1762,6 +1762,11 @@ get_current_frame (void)
   /* Traceframes are effectively a substitute for the live inferior.  */
   if (get_traceframe_number () < 0)
     validate_registers_access ();
+  else if (inferior_ptid != null_ptid
+	   && inferior_thread ()->state () == THREAD_EXITED)
+    /* Not even a traceframe can give the registers of a thread that
+       has gone.  */
+    error (_("The current thread has terminated"));
 
   if (sentinel_frame == nullptr)
     sentinel_frame
@@ -1924,6 +1929,12 @@ has_stack_frames ()
       || !target_has_memory ())
     return false;
 
+  /* Don't try to read from a dead thread, not even in a traceframe:
+     its registers are gone with it.  */
+  if (inferior_ptid != null_ptid
+      && inferior_thread ()->internal_state () == THREAD_INT_EXITED)
+    return false;
+
   /* Traceframes are effectively a substitute for the live inferior.  */
   if (get_traceframe_number () < 0)
     {
@@ -1932,9 +1943,6 @@ has_stack_frames ()
 	return false;
 
       thread_info *tp = inferior_thread ();
-      /* Don't try to read from a dead thread.  */
-      if (tp->internal_state () == THREAD_INT_EXITED)
-	return false;
 
       /* ... or from a spinning thread.  */
       if (tp->internal_state () == THREAD_INT_RUNNING)
diff --git a/gdb/regcache-dump.c b/gdb/regcache-dump.c
index a6dce687573..3f5e2225bfe 100644
--- a/gdb/regcache-dump.c
+++ b/gdb/regcache-dump.c
@@ -269,7 +269,13 @@ regcache_print (const char *args, enum regcache_dump_what what_to_dump,
   std::unique_ptr<regcache> regs;
   gdbarch *gdbarch;
 
-  if (target_has_registers ())
+  /* The registers of the selected thread, if there is one and it has
+     not exited.  */
+  bool thread_regs = (target_has_registers ()
+		      && inferior_ptid != null_ptid
+		      && inferior_thread ()->state () != THREAD_EXITED);
+
+  if (thread_regs)
     gdbarch = get_thread_regcache (inferior_thread ())->arch ();
   else
     gdbarch = current_inferior ()->arch ();
@@ -295,7 +301,7 @@ regcache_print (const char *args, enum regcache_dump_what what_to_dump,
 	name = "RegisterDump";
 	auto dump_pseudo = (what_to_dump == regcache_dump_cooked);
 
-	if (target_has_registers ())
+	if (thread_regs)
 	  dump = (std::make_unique<register_dump_regcache>
 		  (get_thread_regcache (inferior_thread ()), dump_pseudo));
 	else
