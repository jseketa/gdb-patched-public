From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Thu, 19 Nov 2026 23:24:28 +0100
Subject: [PATCH 15/76] gdb: do not set up the solib_ops again after an exec at
 connect

Connecting to a program stopped at an exec set up its solib_ops twice and asserted.

diff --git a/gdb/infcmd.c b/gdb/infcmd.c
index 6592d1b3299..de187106f6c 100644
--- a/gdb/infcmd.c
+++ b/gdb/infcmd.c
@@ -2758,7 +2758,11 @@ setup_inferior (int from_tty)
   /* Take any necessary post-attaching actions for this platform.  */
   target_post_attach (inferior->pid);
 
-  post_create_inferior (from_tty, true);
+  /* If the program stopped at an exec (a remote target can report
+     one while GDB connects), follow_exec has already set the program
+     space up for the new program, its solib_ops included.  */
+  post_create_inferior (from_tty,
+			current_program_space->solib_ops ().empty ());
 }
 
 /* What to do after the first program stops after attaching.  */
diff --git a/gdb/infrun.c b/gdb/infrun.c
index a3aff64171c..c3ff1d6e0fb 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -3876,8 +3876,11 @@ start_remote (int from_tty)
 
   /* Now that the inferior has stopped, do any bookkeeping like
      loading shared libraries.  We want to do this before normal_stop,
-     so that the displayed frame is up to date.  */
-  post_create_inferior (from_tty, true);
+     so that the displayed frame is up to date.  If the target reported
+     the program stopped at an exec, follow_exec has already set the
+     program space up for the new program, its solib_ops included.  */
+  post_create_inferior (from_tty,
+			current_program_space->solib_ops ().empty ());
 
   normal_stop ();
 }
