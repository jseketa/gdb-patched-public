From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Thu, 19 Nov 2026 08:49:02 +0100
Subject: [PATCH 49/72] gdb/infrun: keep the threads in the global step over
 chain in start_step_over

Threads taken out of the step-over chain were not found when the inferior exited; an assertion followed.

diff --git a/gdb/gdbthread.h b/gdb/gdbthread.h
index 51e9ae1b3f0..a1e0a97dfd5 100644
--- a/gdb/gdbthread.h
+++ b/gdb/gdbthread.h
@@ -1043,12 +1043,6 @@ make_thread_step_over_list_safe_range (thread_step_over_list &list)
 
 extern void global_thread_step_over_chain_enqueue (thread_info *tp);
 
-/* Append the thread step over list LIST to the global thread step over
-   chain. */
-
-extern void global_thread_step_over_chain_enqueue_chain
-  (thread_step_over_list &&list);
-
 /* Remove TP from the global pending step-over chain.  */
 
 extern void global_thread_step_over_chain_remove (thread_info *tp);
diff --git a/gdb/infrun.c b/gdb/infrun.c
index 203c36cee87..c3501e83b59 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -2207,40 +2207,23 @@ start_step_over (void)
   if (step_over_info_valid_p ())
     return false;
 
-  /* Steal the global thread step over chain.  As we try to initiate displaced
-     steps, threads will be enqueued in the global chain if no buffers are
-     available.  If we iterated on the global chain directly, we might iterate
-     indefinitely.  */
-  thread_step_over_list threads_to_step
-    = std::move (global_thread_step_over_list);
-
-  infrun_debug_printf ("stealing global queue of threads to step, length = %d",
-		       thread_step_over_chain_length (threads_to_step));
+  /* Look at each thread that is in the global step over chain now,
+     once.  As we try to initiate displaced steps, threads will be
+     enqueued again at the end of the chain if no buffers are available;
+     looking at the chain until it is empty might never end.  The threads
+     stay in the global chain until we take one out to resume it, so that
+     a thread that exits meanwhile (e.g. because the connection to the
+     target is lost) is removed from the chain as at any other time.  */
+  int count = thread_step_over_chain_length (global_thread_step_over_list);
+
+  infrun_debug_printf ("looking at %d threads in the global step over chain",
+		       count);
 
   bool started = false;
 
-  /* On scope exit (whatever the reason, return or exception), if there are
-     threads left in the THREADS_TO_STEP chain, put back these threads in the
-     global list.  */
-  SCOPE_EXIT
-    {
-      if (threads_to_step.empty ())
-	infrun_debug_printf ("step-over queue now empty");
-      else
-	{
-	  infrun_debug_printf ("putting back %d threads to step in global queue",
-			       thread_step_over_chain_length (threads_to_step));
-
-	  global_thread_step_over_chain_enqueue_chain
-	    (std::move (threads_to_step));
-	}
-    };
-
-  thread_step_over_list_safe_range range
-    = make_thread_step_over_list_safe_range (threads_to_step);
-
-  for (thread_info &tp : range)
+  for (; count > 0 && !global_thread_step_over_list.empty (); count--)
     {
+      thread_info &tp = global_thread_step_over_list.front ();
       step_over_what step_what;
       int must_be_in_line;
 
@@ -2249,8 +2232,10 @@ start_step_over (void)
       if (tp.inf->displaced_step_state.unavailable)
 	{
 	  /* The arch told us to not even try preparing another displaced step
-	     for this inferior.  Just leave the thread in THREADS_TO_STEP, it
-	     will get moved to the global chain on scope exit.  */
+	     for this inferior.  Leave the thread in the chain, behind the
+	     threads still to look at.  */
+	  global_thread_step_over_chain_remove (&tp);
+	  global_thread_step_over_chain_enqueue (&tp);
 	  continue;
 	}
 
@@ -2260,17 +2245,20 @@ start_step_over (void)
 	     over chain remains there.  A user could also try to continue a
 	     thread stopped at a breakpoint while another thread is waiting for
 	     a vfork-done event.  In any case, we don't want to start a step
-	     over right now.  */
+	     over right now.  Leave the thread in the chain, behind the threads
+	     still to look at.  */
+	  global_thread_step_over_chain_remove (&tp);
+	  global_thread_step_over_chain_enqueue (&tp);
 	  continue;
 	}
 
-      /* Remove thread from the THREADS_TO_STEP chain.  If anything goes wrong
+      /* Remove thread from the step over chain.  If anything goes wrong
 	 while we try to prepare the displaced step, we don't add it back to
 	 the global step over chain.  This is to avoid a thread staying in the
 	 step over chain indefinitely if something goes wrong when resuming it
 	 If the error is intermittent and it still needs a step over, it will
 	 get enqueued again when we try to resume it normally.  */
-      threads_to_step.erase (threads_to_step.iterator_to (tp));
+      global_thread_step_over_chain_remove (&tp);
 
       step_what = thread_still_needs_step_over (&tp);
       must_be_in_line = ((step_what & STEP_OVER_WATCHPOINT)
diff --git a/gdb/thread.c b/gdb/thread.c
index e2b89afc118..7306e397481 100644
--- a/gdb/thread.c
+++ b/gdb/thread.c
@@ -496,14 +496,6 @@ global_thread_step_over_chain_enqueue (struct thread_info *tp)
 
 /* See gdbthread.h.  */
 
-void
-global_thread_step_over_chain_enqueue_chain (thread_step_over_list &&list)
-{
-  global_thread_step_over_list.splice (std::move (list));
-}
-
-/* See gdbthread.h.  */
-
 void
 global_thread_step_over_chain_remove (struct thread_info *tp)
 {
