From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 07:14:46 +0100
Subject: [PATCH 38/64] gdb/remote: reject a reply to '?' that is not a stop

An all-stop stub answering '?' with something other than a stop made GDB spin forever at connect.

diff --git a/gdb/remote.c b/gdb/remote.c
index d5581779cd8..cb6538bd5a1 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -5634,6 +5634,12 @@ remote_target::start_remote_1 (int from_tty, int extended_p)
 	    error (_("The target is not running (try extended-remote?)"));
 	  return false;
 	}
+      else if (rs->buf[0] != 'T' && rs->buf[0] != 'S')
+	{
+	  /* Anything else is not a stop.  Taking it for the initial stop
+	     would leave GDB waiting for a stop that never comes.  */
+	  error (_("Remote replied unexpectedly to '?': %s"), rs->buf.data ());
+	}
       else
 	{
 	  /* Save the reply for later.  */
