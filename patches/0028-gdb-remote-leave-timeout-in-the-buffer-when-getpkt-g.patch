From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Tue, 17 Nov 2026 21:40:39 +0100
Subject: [PATCH 28/66] gdb/remote: leave "timeout" in the buffer when getpkt
 gives up

A packet that broke off left unterminated bytes that remote_query_supported parsed past the buffer.

diff --git a/gdb/remote.c b/gdb/remote.c
index 46271a5b1b9..80ae167efaf 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -11003,8 +11003,13 @@ remote_target::getpkt (gdb::char_vector *buf, bool forever, bool *is_notif)
 	  if (c == SERIAL_TIMEOUT)
 	    {
 	      if (is_notif != nullptr)
-		return -1; /* Don't complain, it's normal to not get
-			      anything in this case.  */
+		{
+		  /* Don't complain, it's normal to not get anything in
+		     this case.  An earlier try may have left part of a
+		     packet in BUF.  */
+		  strcpy (buf->data (), "timeout");
+		  return -1;
+		}
 
 	      if (forever)	/* Watchdog went off?  Kill the target.  */
 		{
@@ -11037,6 +11042,11 @@ remote_target::getpkt (gdb::char_vector *buf, bool forever, bool *is_notif)
 	  /* Skip the ack char if we're in no-ack mode.  */
 	  if (!rs->noack_mode)
 	    remote_serial_write ("+", 1);
+
+	  /* read_frame may have left part of a packet in BUF, with no
+	     terminating null.  Callers that do not check the result
+	     parse BUF, so give them "timeout", as at the start.  */
+	  strcpy (buf->data (), "timeout");
 	  return -1;
 	}
 
