+
+# Test that attaching to a single-threaded process through
+# extended-remote prints the same thing with and without
+# "maint set target-non-stop on".  GDB does not know the executable
+# yet, and finds it when attaching.  The thread of the process that
+# was attached to must not be announced ahead of the "Reading symbols"
+# line.
+
+load_lib gdbserver-support.exp
+
+standard_testfile ext-attach.c
+
+require allow_gdbserver_tests
+
+require can_spawn_for_attach
+
+if {[build_executable "failed to prepare" $testfile $srcfile debug]} {
+    return
+}
+
+# Run the test.  TARGET_NON_STOP should be 'on' or 'off'.
+
+proc run_test { target_non_stop } {
+    save_vars { ::GDBFLAGS } {
+	append ::GDBFLAGS " -ex \"maint set target-non-stop $target_non_stop\""
+
+	# If GDB and GDBserver are both running locally, set the sysroot
+	# to avoid reading files via the remote protocol.
+	if { ![is_remote host] && ![is_remote target] } {
+	    set ::GDBFLAGS "$::GDBFLAGS -ex \"set sysroot\""
+	}
+
+	# Do not give GDB the executable.
+	clean_restart
+    }
+
+    # Make sure we're disconnected, in case we're testing with an
+    # extended-remote board, therefore already connected.
+    gdb_test "disconnect" ".*"
+
+    gdbserver_start_extended
+
+    set test_spawn_id [spawn_wait_for_attach $::binfile]
+    set testpid [spawn_id_get_pid $test_spawn_id]
+
+    gdb_test "attach $testpid" \
+	[multi_line \
+	     "Attaching to process $::decimal" \
+	     "Reading symbols from \[^\r\n\]+\\.\\.\\." \
+	     ".*"] \
+	"attach prints the symbols line first"
+
+    gdb_test "kill" "" "kill" "Kill the program being debugged. .y or n. " "y"
+    gdb_test_no_output "monitor exit"
+
+    kill_wait_spawned_process $test_spawn_id
+}
+
+foreach_with_prefix target_non_stop {"off" "on"} {
+    run_test ${target_non_stop}
+}
