From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 15:33:53 +0100
Subject: [PATCH 47/76] gdb/remote: reject a stop reply without a signal number

A 'T' reply shorter than "Txx" was parsed past its end.

diff --git a/gdb/remote.c b/gdb/remote.c
index 67e6b9f43ca..9f5939e5415 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -8756,6 +8756,11 @@ remote_target::remote_parse_stop_reply (const char *buf, stop_reply *event)
   event->regcache.clear ();
   event->core = -1;
 
+  /* 'T' and 'S' start with two hex digits of the signal number.  */
+  if ((buf[0] == 'T' || buf[0] == 'S')
+      && (buf[1] == '\0' || buf[2] == '\0'))
+    error (_("Malformed stop reply (no signal number): %s"), buf);
+
   switch (buf[0])
     {
     case 'T':		/* Status with PC, SP, FP, ...	*/
diff --git a/gdb/testsuite/gdb.replay/stop-reply-no-signal.exp b/gdb/testsuite/gdb.replay/stop-reply-no-signal.exp
new file mode 100644
index 00000000000..2788caf1f10
--- /dev/null
+++ b/gdb/testsuite/gdb.replay/stop-reply-no-signal.exp
@@ -0,0 +1,115 @@
