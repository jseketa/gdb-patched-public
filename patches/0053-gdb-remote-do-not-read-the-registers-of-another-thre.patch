From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 21:39:47 +0100
Subject: [PATCH 53/76] gdb/remote: do not read the registers of another thread
 after a rejected Hg

After the stub rejected an Hg, GDB read the registers of whichever thread the stub still had selected.

diff --git a/gdb/remote.c b/gdb/remote.c
index 49f3d1735eb..2ca9dc477fa 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -9911,7 +9911,18 @@ remote_target::fetch_registers (struct regcache *regcache, int regnum)
   int i;
 
   set_remote_traceframe ();
-  set_general_thread (regcache->ptid ());
+  if (!set_general_thread (regcache->ptid ()))
+    {
+      /* The stub has no such thread any more, e.g. because it has just
+	 exited.  Reading now would give the registers of whichever
+	 thread the stub has selected.  */
+      if (regnum >= 0)
+	regcache->raw_supply (regnum, nullptr);
+      else
+	for (i = 0; i < gdbarch_num_regs (gdbarch); i++)
+	  regcache->raw_supply (i, nullptr);
+      return;
+    }
 
   if (regnum >= 0)
     {
@@ -10070,7 +10081,11 @@ remote_target::store_registers (struct regcache *regcache, int regnum)
   int i;
 
   set_remote_traceframe ();
-  set_general_thread (regcache->ptid ());
+  /* If the stub has no such thread any more, do not write the
+     registers of whichever thread it has selected instead.  As for a
+     register we cannot write (see below), do not complain.  */
+  if (!set_general_thread (regcache->ptid ()))
+    return;
 
   if (regnum >= 0)
     {
diff --git a/gdb/testsuite/gdb.replay/hg-rejected-registers.c b/gdb/testsuite/gdb.replay/hg-rejected-registers.c
new file mode 100644
index 00000000000..d50386adce2
