From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 04:17:49 +0100
Subject: [PATCH 08/51] gdbserver: do not use a thread that exited in
 start_step_over

stop_all_lwps can delete the LWP being stepped over (use-after-free).

diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index c4daba0bf40..6106e16fdb9 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -2337,6 +2337,12 @@ linux_process_target::filter_event (int lwpid, int wstat)
 		     lwpid);
 
 		  child = add_lwp (ptid_t (lwpid, lwpid));
+
+		  /* Like a new clone child, leave it suspended if we
+		     are suspending all threads, so that the matching
+		     unsuspend stays balanced.  */
+		  if (stopping_threads == STOPPING_AND_SUSPENDING_THREADS)
+		    child->suspended = 1;
 		  return true;
 		}
 	      return false;
@@ -4542,8 +4548,22 @@ linux_process_target::start_step_over (lwp_info *lwp)
   threads_debug_printf ("Starting step-over on LWP %ld.  Stopping all threads",
 			thread->id.lwp ());
 
+  ptid_t ptid = thread->id;
+
   stop_all_lwps (1, lwp);
 
+  /* The process may have exited while we waited for the other threads
+     to stop.  Then LWP is gone, and THREAD with it, and there is
+     nothing to step over.  */
+  lwp = find_lwp_pid (ptid);
+  if (lwp == nullptr)
+    {
+      threads_debug_printf ("LWP %ld is gone, no step-over", ptid.lwp ());
+      unsuspend_all_lwps (nullptr);
+      proceed_all_lwps ();
+      return;
+    }
+
   if (lwp->suspended != 0)
     {
       internal_error ("LWP %ld suspended=%d\n", thread->id.lwp (),
