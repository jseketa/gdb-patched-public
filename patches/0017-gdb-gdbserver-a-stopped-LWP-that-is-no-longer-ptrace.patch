From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Fri, 20 Nov 2026 12:15:55 +0100
Subject: [PATCH 17/65] gdb, gdbserver: a stopped LWP that is no longer
 ptrace-stopped is not alive

thread_alive said threads killed by another thread's exit_group were alive until their status was collected.

diff --git a/gdb/linux-nat.c b/gdb/linux-nat.c
index 2adfbe46720..f85236d22af 100644
--- a/gdb/linux-nat.c
+++ b/gdb/linux-nat.c
@@ -3914,8 +3914,17 @@ linux_nat_target::xfer_partial (enum target_object object,
 bool
 linux_nat_target::thread_alive (ptid_t ptid)
 {
-  /* As long as a PTID is in lwp list, consider it alive.  */
-  return find_lwp_pid (ptid) != NULL;
+  lwp_info *lp = find_lwp_pid (ptid);
+
+  if (lp == nullptr)
+    return false;
+
+  /* An LWP we have stopped that has left its ptrace-stop is exiting;
+     we will collect its exit status soon.  */
+  if (lp->stopped && linux_proc_lwp_left_trace_stop (lp->ptid.lwp ()))
+    return false;
+
+  return true;
 }
 
 /* Implement the to_update_thread_list target method for this
diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index e998f3a0a8f..0c69c1867a3 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -1700,10 +1700,15 @@ linux_process_target::thread_alive (ptid_t ptid)
   /* We assume we always know if a thread exits.  If a whole process
      exited but we still haven't been able to report it to GDB, we'll
      hold on to the last lwp of the dead process.  */
-  if (lwp != NULL)
-    return !lwp_is_marked_dead (lwp);
-  else
+  if (lwp == NULL || lwp_is_marked_dead (lwp))
+    return 0;
+
+  /* An LWP we have stopped that has left its ptrace-stop is
+     exiting.  */
+  if (lwp->stopped && linux_proc_lwp_left_trace_stop (ptid.lwp ()))
     return 0;
+
+  return 1;
 }
 
 bool
