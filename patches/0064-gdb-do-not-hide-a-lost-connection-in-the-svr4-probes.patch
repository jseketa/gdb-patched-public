From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Thu, 19 Nov 2026 01:44:41 +0100
Subject: [PATCH 64/67] gdb: do not hide a lost connection in the svr4 probes
 interface

A lost connection at a linker probe was a warning; GDB then used a deleted breakpoint.

diff --git a/gdb/solib-svr4.c b/gdb/solib-svr4.c
index 6496abe1367..6ba1dfdfb86 100644
--- a/gdb/solib-svr4.c
+++ b/gdb/solib-svr4.c
@@ -2207,6 +2207,14 @@ svr4_solib_ops::handle_event ()
       }
     catch (const gdb_exception_error &ex)
       {
+	/* Not if the target has gone: the session cannot continue,
+	   and the probes interface has not failed.  */
+	if (ex.error == TARGET_CLOSE_ERROR)
+	  {
+	    cleanup.release ();
+	    throw;
+	  }
+
 	exception_print (gdb_stderr, ex);
 	val = NULL;
       }
