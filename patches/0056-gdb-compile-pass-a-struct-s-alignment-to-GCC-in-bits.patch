From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Fri, 20 Nov 2026 18:27:29 +0100
Subject: [PATCH 56/76] gdb/compile: pass a struct's alignment to GCC in bits

The alignment went to libcc1 in bytes, which takes bits; compile print of a struct overwrote the frame.

diff --git a/gdb/compile/compile-c-types.c b/gdb/compile/compile-c-types.c
index 818cdecd50d..3e8734a007f 100644
--- a/gdb/compile/compile-c-types.c
+++ b/gdb/compile/compile-c-types.c
@@ -117,9 +117,10 @@ convert_struct_or_union (compile_c_instance *context, struct type *type)
 					  type->field (i).loc_bitpos ());
     }
 
+  /* The plugin takes the alignment in bits, as GCC's TYPE_ALIGN.  */
   if (context->plugin ().version () >= GCC_C_FE_VERSION_2)
-    context->plugin ().finish_record_with_alignment (result, type->length (),
-						     type_align (type));
+    context->plugin ().finish_record_with_alignment
+      (result, type->length (), type_align (type) * TARGET_CHAR_BIT);
   else
     context->plugin ().finish_record_or_union (result, type->length ());
   return result;
diff --git a/gdb/testsuite/gdb.compile/compile.c b/gdb/testsuite/gdb.compile/compile.c
index 5247ace9de8..35c5db62374 100644
--- a/gdb/testsuite/gdb.compile/compile.c
+++ b/gdb/testsuite/gdb.compile/compile.c
@@ -107,6 +107,13 @@ struct struct_with_array
 
 static struct struct_with_array swa;
 
+struct struct_with_ints
+{
+  int a, b, c;
+};
+
+static struct struct_with_ints swi = { 1, 2, 3 };
+
 int
 main (void)
 {
diff --git a/gdb/testsuite/gdb.compile/compile.exp b/gdb/testsuite/gdb.compile/compile.exp
index 4429f653a63..47013702ada 100644
--- a/gdb/testsuite/gdb.compile/compile.exp
+++ b/gdb/testsuite/gdb.compile/compile.exp
@@ -404,3 +404,9 @@ gdb_test "p shlibvar" " = 15" "expect 15"
 
 # This used to fail due to alignment.  PR compile/31397.
 gdb_test_no_output "compile code swa.val\[0\] = 1"
+
+# The alignment of a struct GDB passes to GCC is in bits.  With the
+# alignment in bytes, GCC laid out a local copy of such a struct in no
+# stack space at all, and the copy overwrote the return address.
+gdb_test "compile print _Alignof (swi)" " = 4"
+gdb_test "compile print swi" " = \\{a = 1, b = 2, c = 3\\}"
