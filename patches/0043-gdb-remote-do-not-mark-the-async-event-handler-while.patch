From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 19:04:17 +0100
Subject: [PATCH 43/48] gdb/remote: do not mark the async event handler while
 not async

Assertion when connecting to a non-stop target with several stopped threads.

diff --git a/gdb/remote.c b/gdb/remote.c
index 56b762b4a99..00dd2c159dd 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -8466,11 +8466,12 @@ remote_target::queued_stop_reply (ptid_t ptid)
   remote_state *rs = get_remote_state ();
   stop_reply_up r = remote_notif_remove_queued_reply (ptid);
 
-  if (!rs->stop_reply_queue.empty () && target_can_async_p ())
-    {
-      /* There's still at least an event left.  */
-      rs->mark_async_event_handler ();
-    }
+  /* If there's still at least an event left, tell the event loop to
+     get back to target_wait soon.  Only if async mode is currently
+     enabled, as in push_stop_reply: if it gets enabled later,
+     remote_target::async marks the token then.  */
+  if (!rs->stop_reply_queue.empty () && target_is_async_p ())
+    rs->mark_async_event_handler ();
 
   return r;
 }
