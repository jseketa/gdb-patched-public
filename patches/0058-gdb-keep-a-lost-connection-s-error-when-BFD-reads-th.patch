From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 23:22:46 +0100
Subject: [PATCH 58/66] gdb: keep a lost connection's error when BFD reads
 through the target

A connection lost during a read inside BFD was dropped with the target gone, ending in inferior_thread assertions.

diff --git a/gdb/event-top.c b/gdb/event-top.c
index 0fb6eafec57..da1b77ed268 100644
--- a/gdb/event-top.c
+++ b/gdb/event-top.c
@@ -99,6 +99,10 @@ bool set_editing_cmd_var;
    asynchronous execution command.  */
 bool exec_done_display_p = false;
 
+/* See event-top.h.  */
+
+int catch_exceptions_depth;
+
 /* Used by the stdin event handler to compensate for missed stdin events.
    Setting this to a non-zero value inside an stdin callback makes the callback
    run again.  */
diff --git a/gdb/event-top.h b/gdb/event-top.h
index 4b377f8780e..19f5510629c 100644
--- a/gdb/event-top.h
+++ b/gdb/event-top.h
@@ -25,6 +25,7 @@
 #include <signal.h>
 
 #include "extension.h"
+#include "gdbsupport/scoped_restore.h"
 
 struct cmd_list_element;
 
@@ -83,14 +84,26 @@ extern void quit_serial_event_set ();
 
 extern void quit_serial_event_clear ();
 
+/* The number of catch_exceptions calls on the stack.  While it is not
+   zero, an error thrown does not reach GDB's own code: the caller of
+   catch_exceptions only sees a failure.  */
+
+extern int catch_exceptions_depth;
+
 /* Wrap f (args) and handle exceptions by:
    - returning val, and
-   - calling set_quit_flag or set_force_quit_flag, if needed.  */
+   - calling set_quit_flag or set_force_quit_flag, if needed.
+   This is for calls from code that exceptions must not cross, such as
+   the callbacks BFD and the disassembler make.  */
 
 template <typename R, R val, typename F, typename... Args>
 static R
 catch_exceptions (F &&f, Args&&... args)
 {
+   scoped_restore restore_depth
+     = make_scoped_restore (&catch_exceptions_depth,
+			    catch_exceptions_depth + 1);
+
    try
      {
        return f (std::forward<Args> (args)...);
diff --git a/gdb/exec.c b/gdb/exec.c
index 806f9b0a67a..6ef3a22d22f 100644
--- a/gdb/exec.c
+++ b/gdb/exec.c
@@ -188,6 +188,10 @@ try_open_exec_file (const char *exec_file_host, struct inferior *inf,
     }
   catch (gdb_exception_error &err)
     {
+      /* Not if the target has gone: the session cannot continue.  */
+      if (err.error == TARGET_CLOSE_ERROR)
+	throw;
+
       if (err.message != NULL)
 	warning ("%s", err.what ());
 
@@ -202,6 +206,9 @@ try_open_exec_file (const char *exec_file_host, struct inferior *inf,
 	}
       catch (const gdb_exception_error &err)
 	{
+	  if (err.error == TARGET_CLOSE_ERROR)
+	    throw;
+
 	  if (prev_err != err)
 	    warning ("%s", err.what ());
 	}
diff --git a/gdb/gdb_bfd.c b/gdb/gdb_bfd.c
index 5def8093138..e993337c9e7 100644
--- a/gdb/gdb_bfd.c
+++ b/gdb/gdb_bfd.c
@@ -974,7 +974,13 @@ gdb_bfd_openr_iovec (const char *filename, const char *target,
   auto close_trampoline = [] (struct bfd *nbfd, void *stream) -> int
   {
     gdb_bfd_iovec_base *obj = static_cast<gdb_bfd_iovec_base *> (stream);
-    delete obj;
+    /* The destructor does not throw, but it runs for BFD like the other
+       callbacks: errors in it do not reach GDB's code either.  */
+    catch_exceptions<int, 0> ([&]
+      {
+	delete obj;
+	return 0;
+      });
     /* Success.  */
     return 0;
   };
diff --git a/gdb/remote.c b/gdb/remote.c
index bf2192fe074..0d48109c1c7 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -10616,6 +10616,21 @@ remote_target::flash_done ()
    sequence, as that would break communication with the remote server.
    See remote_serial_quit_handler for more detail.  */
 
+/* The connection to TARGET has failed: unpush TARGET, before the
+   caller throws TARGET_CLOSE_ERROR.  Unless that error would not reach
+   GDB's own code (see catch_exceptions), e.g. when BFD reads a file
+   through the target: the code that made BFD read would then go on
+   as if the target were there, with the target gone.  Leave it pushed
+   in that case.  The connection stays broken, so the next use of it,
+   from GDB's own code, fails here again and unpushes it then.  */
+
+static void
+remote_connection_failed (remote_target *target)
+{
+  if (catch_exceptions_depth == 0)
+    remote_unpush_target (target);
+}
+
 int
 remote_target::readchar (int timeout)
 {
@@ -10638,7 +10653,7 @@ remote_target::readchar (int timeout)
     }
   catch (const gdb_exception_error &ex)
     {
-      remote_unpush_target (this);
+      remote_connection_failed (this);
       throw_error (TARGET_CLOSE_ERROR,
 		   _("Remote communication error.  "
 		     "Target disconnected: %s"),
@@ -10650,7 +10665,7 @@ remote_target::readchar (int timeout)
 
   if (ch == SERIAL_EOF)
     {
-      remote_unpush_target (this);
+      remote_connection_failed (this);
       throw_error (TARGET_CLOSE_ERROR, _("Remote connection closed"));
     }
 
@@ -10681,7 +10696,7 @@ remote_target::remote_serial_write (const char *str, int len)
     }
   catch (const gdb_exception_error &ex)
     {
-      remote_unpush_target (this);
+      remote_connection_failed (this);
       throw_error (TARGET_CLOSE_ERROR,
 		   _("Remote communication error.  "
 		     "Target disconnected: %s"),
@@ -10703,7 +10718,7 @@ remote_target::remote_serial_send_break ()
     }
   catch (const gdb_exception_error &ex)
     {
-      remote_unpush_target (this);
+      remote_connection_failed (this);
       throw_error (TARGET_CLOSE_ERROR,
 		   _("Remote communication error.  "
 		     "Target disconnected: %s"),
diff --git a/gdb/solib.c b/gdb/solib.c
index 4d5e136ba03..97f3843f53a 100644
--- a/gdb/solib.c
+++ b/gdb/solib.c
@@ -784,6 +784,11 @@ update_solib_list (int from_tty)
 	    }
 	  catch (const gdb_exception_error &ex)
 	    {
+	      /* Not if the target has gone: the session cannot
+		 continue.  */
+	      if (ex.error == TARGET_CLOSE_ERROR)
+		throw;
+
 	      exception_fprintf (gdb_stderr, ex,
 				 "Error reading attached "
 				 "process's symbol file.\n");
