+
+# "info static-tracepoint-markers" on a native GNU/Linux program that
+# does not load the in-process agent.  GDB stopped and then resumed all
+# threads around asking the agent, so the command let the stopped
+# program run.  It must leave the program stopped.
+
+require {istarget "*-*-linux*"}
+require !gdb_protocol_is_remote
+
+standard_testfile
+
+if { [prepare_for_testing "failed to prepare" $testfile $srcfile] } {
+    return
+}
+
+if { ![runto_main] } {
+    return
+}
+
+# Only the table header: there is no agent to list markers.
+gdb_test "info static-tracepoint-markers" \
+    "Cnt +ID +Enb +Address +What" \
+    "no markers without the agent"
+
+# The thread must still be stopped where it was.
+gdb_test "info threads" "\\* 1 +\[^\r\n\]* main \\(\\) at \[^\r\n\]*" \
+    "thread is still stopped"
+gdb_test "print \$pc" " = .* <main\\+\[0-9\]+>" "pc can be read"
