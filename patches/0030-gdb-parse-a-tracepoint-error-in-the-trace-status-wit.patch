From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Tue, 17 Nov 2026 22:21:27 +0100
Subject: [PATCH 30/37] gdb: parse a tracepoint error in the trace status
 without a description

"terror:41" sized an allocation from a null pointer.

diff --git a/gdb/tracepoint.c b/gdb/tracepoint.c
index 46d6237c31d..dd0a26faf2c 100644
--- a/gdb/tracepoint.c
+++ b/gdb/tracepoint.c
@@ -3306,14 +3306,17 @@ Status line: '%s'\n"), p, line);
       else if (strncmp (p, stop_reason_names[tracepoint_error], p1 - p) == 0)
 	{
 	  p2 = strchr (++p1, ':');
-	  if (p2 != p1)
+	  if (p2 == nullptr || p2 > p3)
 	    {
-	      ts->stop_desc = hex_field_to_string (p1, p2);
+	      /* No description, only the number of the tracepoint.  */
+	      ts->stop_desc = xstrdup ("");
+	      p = unpack_varlen_hex (p1, &val);
 	    }
 	  else
-	    ts->stop_desc = xstrdup ("");
-
-	  p = unpack_varlen_hex (++p2, &val);
+	    {
+	      ts->stop_desc = hex_field_to_string (p1, p2);
+	      p = unpack_varlen_hex (p2 + 1, &val);
+	    }
 	  ts->stopping_tracepoint = val;
 	  ts->stop_reason = tracepoint_error;
 	}
