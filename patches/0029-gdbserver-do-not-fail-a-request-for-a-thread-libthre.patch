From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 19:18:09 +0100
Subject: [PATCH 29/64] gdbserver: do not fail a request for a thread
 libthread_db cannot find

A thread exiting while stepped ended the session with "Cannot get thread handle".

diff --git a/gdbserver/thread-db.cc b/gdbserver/thread-db.cc
index fd3928b7d2c..bc0ab72058a 100644
--- a/gdbserver/thread-db.cc
+++ b/gdbserver/thread-db.cc
@@ -177,15 +177,26 @@ find_one_thread (ptid_t ptid)
   int lwpid = ptid.lwp ();
   td_err_e err = thread_db->td_ta_map_lwp2thr_p (thread_db->thread_agent, lwpid,
 						 &th);
+
+  /* libthread_db can fail to find a thread that is on its way out, for
+     example a thread group leader that filter_event added back after
+     its exit, while the process exits.  The callers handle a thread
+     that is not found, so don't fail the request that asked.  */
   if (err != TD_OK)
-    error (_("Cannot get thread handle for LWP %d: %s"),
-	   lwpid, thread_db_err_str (err));
+    {
+      threads_debug_printf ("Cannot get thread handle for LWP %d: %s",
+			    lwpid, thread_db_err_str (err));
+      return 0;
+    }
 
   td_thrinfo_t ti;
   err = thread_db->td_thr_get_info_p (&th, &ti);
   if (err != TD_OK)
-    error (_("Cannot get thread info for LWP %d: %s"),
-	   lwpid, thread_db_err_str (err));
+    {
+      threads_debug_printf ("Cannot get thread info for LWP %d: %s",
+			    lwpid, thread_db_err_str (err));
+      return 0;
+    }
 
   threads_debug_printf ("Found thread %ld (LWP %d)",
 			(unsigned long) ti.ti_tid, ti.ti_lid);
