From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 01:03:49 +0100
Subject: [PATCH 32/76] gdbserver: leave unavailable registers out of a stop
 reply

Registers a thread that just exited cannot have were sent as 'x' digits in a T reply, which only a g reply may contain.

diff --git a/gdbserver/remote-utils.cc b/gdbserver/remote-utils.cc
index 8192e4577f2..91684f81056 100644
--- a/gdbserver/remote-utils.cc
+++ b/gdbserver/remote-utils.cc
@@ -996,6 +996,11 @@ write_enn (char *buf)
 static char *
 outreg (struct regcache *regcache, int regno, char *buf)
 {
+  /* The value of a thread that just exited can be unavailable.  Unlike
+     the 'g' reply, a stop reply has no way to say so: leave it out.  */
+  if (regcache->get_register_status (regno) != REG_VALID)
+    return buf;
+
   if ((regno >> 12) != 0)
     *buf++ = tohex ((regno >> 12) & 0xf);
   if ((regno >> 8) != 0)
