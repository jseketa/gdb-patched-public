+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+# Test changing "set non-stop" while connected with extended-remote, but
+# with no program yet.  GDB has to tell the stub before it starts or
+# attaches to one, otherwise the two disagree on how to talk to each
+# other: in non-stop mode GDB rejects the stop reply of an all-stop stub,
+# and the program is left shown as running.
+
+load_lib gdbserver-support.exp
+
+standard_testfile ext-attach.c
+
+require allow_gdbserver_tests
+
+if {[build_executable "failed to prepare" $testfile $srcfile debug]} {
+    return
+}
+
+# Connect with "set non-stop FROM", change that to TO, and then get a
+# program with HOW, which is "run" or "attach".
+proc run_test { how from to } {
+    save_vars { ::GDBFLAGS } {
+	# If GDB and GDBserver are both running locally, set the sysroot to
+	# avoid reading files via the remote protocol.
+	if { ![is_remote host] && ![is_remote target] } {
+	    append ::GDBFLAGS " -ex \"set sysroot\""
+	}
+
+	clean_restart $::testfile
+    }
+
+    # Make sure we're disconnected, in case we're testing with an
+    # extended-remote board, therefore already connected.
+    gdb_test "disconnect" ".*"
+
+    gdb_test_no_output "set non-stop $from"
+
+    set target_exec [gdbserver_download_current_prog]
+    gdbserver_start_extended
+
+    gdb_test_no_output "set non-stop $to"
+
+    if { $how eq "run" } {
+	gdb_test_no_output "set remote exec-file $target_exec"
+
+	gdb_breakpoint main
+	gdb_test "run" "Breakpoint $::decimal.* main .*" "run to main"
+    } else {
+	set test_spawn_id [spawn_wait_for_attach $::binfile]
+	set testpid [spawn_id_get_pid $test_spawn_id]
+
+	gdb_test "attach $testpid" "Attaching to .* $testpid.*" "attach"
+    }
+
+    gdb_test_multiple "info threads" "thread is stopped" {
+	-re "\\(running\\)\r\n$::gdb_prompt $" {
+	    fail $gdb_test_name
+	}
+	-re -wrap "\\* 1 .*" {
+	    pass $gdb_test_name
+	}
+    }
+
+    gdb_test "kill" "\\\[Inferior $::decimal \\(.*\\) killed\\\]" "kill" \
+	"Kill the program being debugged\\? \\(y or n\\) $" "y"
+
+    if { $how eq "attach" } {
+	kill_wait_spawned_process $test_spawn_id
+    }
+}
+
+foreach_with_prefix how {run attach} {
+    if { $how eq "attach" && ![can_spawn_for_attach] } {
+	continue
+    }
+
+    foreach_with_prefix change {{off on} {on off}} {
+	run_test $how [lindex $change 0] [lindex $change 1]
+    }
+}
