From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 20:20:20 +0100
Subject: [PATCH 21/66] gdbserver: pass on the signals a program gets while it
 starts up

Startup hung when the shell waited for a signal gdbserver dropped (zsh command substitution, fish).

diff --git a/gdbserver/target.cc b/gdbserver/target.cc
index 43ef421df74..7d5110f01e7 100644
--- a/gdbserver/target.cc
+++ b/gdbserver/target.cc
@@ -206,6 +206,25 @@ target_mourn_inferior (ptid_t ptid)
   the_target->mourn (find_process_pid (ptid.pid ()));
 }
 
+/* startup_inferior resumes a process that is starting up after each
+   event it waits for, with the signal it stopped with.  No client sees
+   those stops, so nothing tags the threads as wanting to be stopped,
+   as is done when a stop is reported.  The resume below would then be
+   taken as one for threads already resumed and be ignored, and the
+   signal lost.  Tag them here.  */
+
+static void
+tag_starting_up_threads_stopped (ptid_t ptid)
+{
+  process_info *proc = find_process_pid (ptid.pid ());
+
+  if (proc == nullptr || !proc->starting_up)
+    return;
+
+  for (thread_info &thread : proc->thread_list ())
+    thread.last_resume_kind = resume_stop;
+}
+
 /* See target/target.h.  */
 
 void
@@ -213,6 +232,8 @@ target_continue_no_signal (ptid_t ptid)
 {
   struct thread_resume resume_info;
 
+  tag_starting_up_threads_stopped (ptid);
+
   resume_info.thread = ptid;
   resume_info.kind = resume_continue;
   resume_info.sig = GDB_SIGNAL_0;
@@ -226,6 +247,8 @@ target_continue (ptid_t ptid, enum gdb_signal signal)
 {
   struct thread_resume resume_info;
 
+  tag_starting_up_threads_stopped (ptid);
+
   resume_info.thread = ptid;
   resume_info.kind = resume_continue;
   resume_info.sig = gdb_signal_to_host (signal);
