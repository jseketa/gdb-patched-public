From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 04:17:49 +0100
Subject: [PATCH 10/30] gdbserver: restore the signal mask before retrying a
 wait

The retry saved the blocked mask and sigsuspend then waited forever.

diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index d57bacdc4e0..e14d93d68cd 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -2697,7 +2697,12 @@ linux_process_target::wait_for_event_filtered (ptid_t wait_ptid,
       /* Check for zombie thread group leaders.  Those can't be reaped
 	 until all other threads in the thread group are.  */
       if (check_zombie_leaders ())
-	goto retry;
+	{
+	  /* RETRY blocks the signals again, and would save this mask,
+	     with everything blocked, for the sigsuspend below.  */
+	  gdb_sigmask (SIG_SETMASK, &prev_mask, NULL);
+	  goto retry;
+	}
 
       auto not_stopped = [&] (thread_info *thread)
 	{
