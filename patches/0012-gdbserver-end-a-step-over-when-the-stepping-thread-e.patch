From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 04:28:17 +0100
Subject: [PATCH 12/45] gdbserver: end a step-over when the stepping thread
 execs

Clear step_over_bkpt when exec deletes the process; gdbserver aborted otherwise (PR gdb/27020).

diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index d455262df79..0feba5c31cf 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -782,6 +782,15 @@ linux_process_target::handle_extended_wait (lwp_info **orig_event_lwp,
       mourn (proc);
       switch_to_thread (nullptr);
 
+      /* A thread of this process was stepping over a breakpoint.  The
+	 program it was in is gone, and with it the breakpoint to
+	 reinsert, so the step-over is over.  */
+      if (step_over_bkpt.pid () == event_pid)
+	{
+	  step_over_bkpt = null_ptid;
+	  unsuspend_all_lwps (nullptr);
+	}
+
       /* Create a new process/lwp/thread.  */
       proc = add_linux_process (event_pid, 0);
       event_lwp = add_lwp (event_ptid);
@@ -2578,7 +2587,10 @@ linux_process_target::wait_for_event_filtered (ptid_t wait_ptid,
   else if (filter_ptid != null_ptid)
     {
       requested_child = find_lwp_pid (filter_ptid);
-      gdb_assert (requested_child != nullptr);
+
+      /* The LWP may be gone by now, it may have execd.  */
+      if (requested_child == nullptr)
+	return -1;
 
       if (stopping_threads == NOT_STOPPING_THREADS
 	  && requested_child->status_pending_p
