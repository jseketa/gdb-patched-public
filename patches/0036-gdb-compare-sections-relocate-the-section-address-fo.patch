From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 23:20:44 +0100
Subject: [PATCH 36/76] gdb: compare-sections: relocate the section address for
 PIE

compare-sections read unrelocated addresses for a PIE.

diff --git a/gdb/remote.c b/gdb/remote.c
index d40fc2ab914..bdd1ab5011a 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -12388,6 +12388,17 @@ compare_sections_command (const char *args, int from_tty)
       matched = 1;		/* Do this section.  */
       lma = s->lma;
 
+      /* The section table holds the section's address after any
+	 relocation, e.g. the load bias of a PIE.  Apply the same
+	 displacement to the LMA.  */
+      for (const target_section &ts
+	     : current_program_space->target_sections ())
+	if (ts.the_bfd_section == s)
+	  {
+	    lma += ts.addr - bfd_section_vma (s);
+	    break;
+	  }
+
       gdb::byte_vector sectdata (size);
       bfd_get_section_contents (current_program_space->exec_bfd (), s,
 				sectdata.data (), 0, size);
diff --git a/gdb/testsuite/gdb.base/compare-sections.exp b/gdb/testsuite/gdb.base/compare-sections.exp
index ba2687dbcb8..883cf0a99b3 100644
--- a/gdb/testsuite/gdb.base/compare-sections.exp
+++ b/gdb/testsuite/gdb.base/compare-sections.exp
@@ -21,8 +21,6 @@ if {[prepare_for_testing "failed to prepare" $testfile $srcfile {debug}]} {
     return
 }
 
-set is_pie [exec_is_pie $binfile]
-
 # Run the compare-sections command along with any options as specified
 # by OPTIONS, and check that no mismatch is found.
 proc compare_sections { {options ""} } {
@@ -88,13 +86,8 @@ with_test_prefix "after run to main" {
     gdb_test "compare-sections" \
 	"MIS-MATCHED.*warning.*One or more sections.*does not match.*loaded file"
 
-    if { $is_pie == 1 } {
-	gdb_test "compare-sections -r" \
-	    "MIS-MATCHED.*warning.*One or more sections.*does not match.*loaded file"
-    } else {
-	# Assume startup code doesn't change read-only sections.
-	compare_sections "-r"
-    }
+    # Assume startup code doesn't change read-only sections.
+    compare_sections "-r"
 }
 
