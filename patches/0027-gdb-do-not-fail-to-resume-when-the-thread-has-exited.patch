From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 04:17:50 +0100
Subject: [PATCH 27/76] gdb: do not fail to resume when the thread has exited

handle_thread_exited could pick a dead thread, and resume_1 threw on its registers.

diff --git a/gdb/infrun.c b/gdb/infrun.c
index 931a29fb2dd..dcbeec23992 100644
--- a/gdb/infrun.c
+++ b/gdb/infrun.c
@@ -2764,7 +2764,9 @@ resume_1 (enum gdb_signal sig)
       step = false;
     }
 
-  CORE_ADDR pc = regcache_read_pc (regcache);
+  /* Protected, as this thread may have exited with the process, and
+     the target will tell us so once it is resumed.  */
+  CORE_ADDR pc = regcache_read_pc_protected (regcache);
 
   infrun_debug_printf ("step=%d, signal=%s, trap_expected=%d, "
 		       "current thread [%s] at %s",
diff --git a/gdb/testsuite/gdb.replay/exited-thread-no-registers.c b/gdb/testsuite/gdb.replay/exited-thread-no-registers.c
new file mode 100644
index 00000000000..184d07dcbfe
--- /dev/null
+++ b/gdb/testsuite/gdb.replay/exited-thread-no-registers.c
@@ -0,0 +1,34 @@
