From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 21:31:59 +0100
Subject: [PATCH 37/76] gdb/remote: ignore a stop reply for a thread that is
 not resumed

A duplicate stop reply in non-stop hit a skip_inline_frames assertion.

diff --git a/gdb/remote.c b/gdb/remote.c
index bdd1ab5011a..9d0efb1d59c 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -9215,6 +9215,32 @@ remote_target::process_stop_reply (stop_reply_up stop_reply,
     ptid = select_thread_for_ambiguous_stop_reply (*status);
   gdb_assert (ptid != null_ptid);
 
+  /* In non-stop mode a stop of a thread is reported once per resume.
+     If the stub reports a plain stop of a thread we already know as
+     stopped, the reply is a duplicate.  Handing it to the core would
+     make it process a stop for a thread that has not run since the
+     last one.  Ignore it.  The initial stop replies of a connection
+     are for threads that were stopped before we were there.  Other
+     events can name a thread that GDB did not resume, e.g. an exec,
+     which is reported for the leader, so only look at plain stops.  */
+  if (target_is_non_stop_p ()
+      && !rs->starting_up
+      && status->kind () == TARGET_WAITKIND_STOPPED)
+    {
+      thread_info *thr = this->find_thread (ptid);
+
+      if (thr != nullptr
+	  && (get_remote_thread_info (thr)->get_resume_state ()
+	      == resume_state::NOT_RESUMED))
+	{
+	  remote_debug_printf ("ignoring stop reply for %s, "
+			       "which is not resumed",
+			       ptid.to_string ().c_str ());
+	  status->set_ignore ();
+	  return minus_one_ptid;
+	}
+    }
+
   if (status->kind () != TARGET_WAITKIND_EXITED
       && status->kind () != TARGET_WAITKIND_SIGNALLED
       && status->kind () != TARGET_WAITKIND_NO_RESUMED)
diff --git a/gdb/testsuite/gdb.replay/duplicate-stop.c b/gdb/testsuite/gdb.replay/duplicate-stop.c
new file mode 100644
index 00000000000..406da2fb3ec
--- /dev/null
+++ b/gdb/testsuite/gdb.replay/duplicate-stop.c
@@ -0,0 +1,32 @@
