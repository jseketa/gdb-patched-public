From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Wed, 18 Nov 2026 06:49:53 +0100
Subject: [PATCH 32/66] gdb: do not select a ptid without a thread after a
 failed displaced-step write

A connection lost during the restore write let the scope exit select a ptid with no thread: assertion in inferior_thread.

diff --git a/gdb/displaced-stepping.c b/gdb/displaced-stepping.c
index 4346fdc7389..5ce750de824 100644
--- a/gdb/displaced-stepping.c
+++ b/gdb/displaced-stepping.c
@@ -198,7 +198,17 @@ static void
 write_memory_ptid (ptid_t ptid, CORE_ADDR memaddr,
 		   const gdb_byte *myaddr, int len)
 {
-  scoped_restore save_inferior_ptid = make_scoped_restore (&inferior_ptid);
+  ptid_t saved_ptid = inferior_ptid;
+
+  /* Select SAVED_PTID again afterwards, unless GDB has switched to no
+     thread meanwhile.  A write that loses the remote connection
+     deletes the threads, and SAVED_PTID would then be selected with no
+     thread behind it.  */
+  SCOPE_EXIT
+    {
+      if (inferior_ptid != null_ptid)
+	inferior_ptid = saved_ptid;
+    };
 
   inferior_ptid = ptid;
   write_memory (memaddr, myaddr, len);
