From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sun, 8 Nov 2026 07:59:13 +0100
Subject: [PATCH 63/65] gdb/remote: don't select a ptid without a thread in
 attach

A lost connection in that window asserted in inferior_thread.

diff --git a/gdb/remote.c b/gdb/remote.c
index 70291abebb2..77ca880db8c 100644
--- a/gdb/remote.c
+++ b/gdb/remote.c
@@ -4383,7 +4383,7 @@ remote_newthread_step (threadref *ref, void *data)
 {
   struct threads_listing_context *context
     = (struct threads_listing_context *) data;
-  int pid = inferior_ptid.pid ();
+  int pid = current_inferior ()->pid;
   int lwp = threadref_to_int (ref);
   ptid_t ptid (pid, lwp);
 
@@ -7309,8 +7309,6 @@ extended_remote_target::attach (const char *args, int from_tty)
 
   switch_to_inferior_no_thread (remote_add_inferior (false, pid, 1, 0));
 
-  inferior_ptid = ptid_t (pid);
-
   if (target_is_non_stop_p ())
     {
       /* All-stop adds the main thread silently, below.  Do the same
