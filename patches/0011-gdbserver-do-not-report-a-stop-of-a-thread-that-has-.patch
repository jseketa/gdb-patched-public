From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 04:17:50 +0100
Subject: [PATCH 11/48] gdbserver: do not report a stop of a thread that has
 gone

A stop for a thread of a dying process confused GDB.

diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index e14d93d68cd..d455262df79 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -3609,6 +3609,23 @@ linux_process_target::wait_1 (ptid_t ptid, target_waitstatus *ourstatus,
 	unstop_all_lwps (1, event_child);
     }
 
+  /* The process may have died since this thread stopped.  Then there
+     is nothing to report: the thread's siginfo and registers are gone,
+     and its exit is on its way.  Wait for that.  */
+  siginfo_t siginfo;
+  if (WIFSTOPPED (w)
+      && event_child->waitstatus.kind () == TARGET_WAITKIND_IGNORE
+      && ptrace (PTRACE_GETSIGINFO, current_thread->id.lwp (),
+		 (PTRACE_TYPE_ARG3) 0, &siginfo) != 0
+      && check_ptrace_stopped_lwp_gone (event_child))
+    {
+      threads_debug_printf ("LWP %ld is gone, not reporting its stop",
+			    current_thread->id.lwp ());
+      if (!non_stop)
+	unstop_all_lwps (0, nullptr);
+      return ignore_event (ourstatus);
+    }
+
   /* At this point, we haven't set OURSTATUS.  This is where we do it.  */
   gdb_assert (ourstatus->kind () == TARGET_WAITKIND_IGNORE);
 
