From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josip Seketa <josip.seketa@gmail.com>
Date: Sat, 7 Nov 2026 23:22:33 +0100
Subject: [PATCH 24/67] gdbserver: send SIGINT to the debugged process when the
 first one is gone

Ctrl-C failed after gdbserver detached from the process it started (follow-fork-mode child).

diff --git a/gdbserver/linux-low.cc b/gdbserver/linux-low.cc
index 0feba5c31cf..379a812c431 100644
--- a/gdbserver/linux-low.cc
+++ b/gdbserver/linux-low.cc
@@ -5631,12 +5631,31 @@ linux_process_target::look_up_symbols ()
 void
 linux_process_target::request_interrupt ()
 {
-  /* Send a SIGINT to the process group.  This acts just like the user
-     typed a ^C on the controlling terminal.  */
-  int res = ::kill (-signal_pid, SIGINT);
-  if (res == -1)
-    warning (_("Sending SIGINT to process group of pid %ld failed: %s"),
-	     signal_pid, safe_strerror (errno));
+  /* If we still debug the process we started or attached to, send a
+     SIGINT to its process group.  This acts just like the user typed
+     a ^C on the controlling terminal.  */
+  if (find_process_pid (signal_pid) != nullptr)
+    {
+      int res = ::kill (-signal_pid, SIGINT);
+      if (res == -1)
+	warning (_("Sending SIGINT to process group of pid %ld failed: %s"),
+		 signal_pid, safe_strerror (errno));
+      return;
+    }
+
+  /* That process is gone or was detached, e.g., after following a fork
+     child.  Its process group may be empty, or the debugged process
+     may have left it (setsid), so send the SIGINT to the process
+     itself, like GDB does for a native inferior and like gdbserver
+     does on NetBSD.  */
+  thread_info *thread = get_first_thread ();
+  if (thread == nullptr)
+    return;
+
+  pid_t pid = thread->id.pid ();
+  if (::kill (pid, SIGINT) == -1)
+    warning (_("Sending SIGINT to process %d failed: %s"),
+	     (int) pid, safe_strerror (errno));
 }
 
 bool
